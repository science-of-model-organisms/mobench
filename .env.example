# Copy to .env (gitignored) and fill in. These are secrets: never commit .env.

# Hugging Face. Required to pull base models and adapters and to read published results; read
# access is enough to score organisms. Uploading needs a WRITE token (a browser-OAuth `hf auth login`
# gives a read-only session token; log in with a write access token instead). https://huggingface.co/settings/tokens
HF_TOKEN=

# Optional: the Hugging Face org (or user) you upload to (default in core/hf.py).
# MO_EVALS_HF_ORG=your-org

# OpenRouter. Required by every judged eval (the judges and the debate adversary); judge-free
# evals run without it. https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# OpenAI. Optional: only some data-generation scripts whose config names OPENAI_API_KEY need it.
# Set JUDGE_BASE_URL if a judge block with no base_url should use an OpenAI-compatible gateway
# instead of api.openai.com.
OPENAI_API_KEY=

# Anthropic. Optional, and nothing in the shipped configs reads it: only needed if a config
# names an Anthropic model directly (an `anthropic/...` model through Inspect also needs the
# `anthropic` package, which is not installed by default).
ANTHROPIC_API_KEY=
