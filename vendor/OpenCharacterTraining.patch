+    for message in row["conversation"]:
+        messages.append({"role": role, "content": message})
+        role = "assistant" if role == "user" else "user"
+    messages = start + messages
+    assert len(row["conversation"]) == K and messages[-1]["role"] == "assistant"
+    return messages
